# ============================================================
# OA Screening System — Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in your real values.
#   cp .env.example .env
# NEVER commit your real .env file to version control.

# ----- Firebase Configuration -----
FIREBASE_CREDENTIALS_PATH=secrets/firebase-key.json
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_DATABASE_URL=https://your-firebase-project-id-default-rtdb.asia-southeast1.firebasedatabase.app

# ----- Serial Communication -----
SERIAL_PORT=
SERIAL_BAUD_RATE=115200
BAUD_RATE=115200

# ----- Patient (default for bridge CLI) -----
PATIENT_ID=patient_001

# ----- Demo / Development Mode -----
# Set to false when using real hardware + real Firebase
DEMO_MODE=false

# ----- Data Paths -----
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
DATA_DEMO_DIR=data/demo
MODELS_DIR=models

# ----- Google Gemini AI -----
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL_NAME=gemini-2.5-flash

# ----- Logging -----
LOG_LEVEL=INFO
